{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "cleanUrls": true,
  "trailingSlash": false,
  "rewrites": [
    { "source": "/", "destination": "/index.html" },
    { "source": "/services/vidhuky", "destination": "/services/vidhuky/index.html" },
    { "source": "/services/google-maps", "destination": "/services/google-maps/index.html" },
    { "source": "/services/vedennya-biznesu", "destination": "/services/vedennya-biznesu/index.html" },
    { "source": "/services/lendinhy", "destination": "/services/lendinhy/index.html" },
    { "source": "/terms", "destination": "/terms/index.html" },
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}
